Table users { id int [pk, increment] name varchar email varchar [unique] role varchar created_at timestamp }
Table categories { id int [pk, increment] name varchar [unique] description text }
Table products { id int [pk, increment] category_id int [not null] sku varchar [unique] name varchar price int stock int is_active boolean created_at timestamp updated_at timestamp }
Table customers { id int [pk, increment] name varchar phone varchar [unique, null] created_at timestamp }
Table payment_methods { id int [pk, increment] name varchar [unique] }
Table transactions { id int [pk, increment] invoice_number varchar [unique] user_id int customer_id int [null] payment_method_id int total_amount int paid_amount int change_amount int status varchar created_at timestamp }
Table transaction_items { id int [pk, increment] transaction_id int product_id int quantity int unit_price int subtotal int }
Ref: categories.id < products.category_id
Ref: users.id < transactions.user_id
Ref: customers.id < transactions.customer_id
Ref: payment_methods.id < transactions.payment_method_id
Ref: transactions.id < transaction_items.transaction_id
Ref: products.id < transaction_items.product_id
